# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit real values; .env itself is gitignored.

# TiDB Cloud / MySQL. Leave empty to run without a database (the EGV Data tab
# stays disabled). TiDB needs the ssl suffix, e.g.
#   mysql://user:pass@host:4000/db?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Your Dexcom developer app: developer.dexcom.com > My Apps
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=

# Site sign-in. With VIEWER_PASSWORD empty, development skips sign-in and
# treats everyone as admin. Production requires VIEWER_PASSWORD and SESSION_SECRET.
VIEWER_PASSWORD=
ADMIN_PASSWORD=
# A long random value, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# Optional live data from Dexcom Share: the CGM wearer's own Dexcom login, set
# only with their agreement. Dexcom locks accounts after repeated failed
# sign-ins, so don't experiment with wrong passwords.
DEXCOM_SHARE_USERNAME=
DEXCOM_SHARE_PASSWORD=
